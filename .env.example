# Local Postgres from docker-compose.yml. On Vercel, use the Neon pooled URL.
DATABASE_URL="postgresql://manychat:manychat@localhost:5432/manychat"

# Public base URL of this app (used in tracked links). Locally: your tunnel URL.
APP_URL="http://localhost:3000"

# Instagram API with Instagram Login (Meta app > Instagram > API setup with Instagram login)
INSTAGRAM_APP_SECRET=""
# Any random string; paste the same value in the Meta webhook settings.
INSTAGRAM_VERIFY_TOKEN=""
# Long-lived token generated for your Red Thread account in the Meta app dashboard.
# Used once to create the account row; afterwards the token lives in the database.
INSTAGRAM_ACCESS_TOKEN=""
GRAPH_API_VERSION="v26.0"

# Facebook Page + Messenger (phase 2). Optional until you connect the Page.
# Meta app secret (App settings > Basic). Signs Page webhooks; differs from the Instagram app secret.
FACEBOOK_APP_SECRET=""
# Leave empty to reuse INSTAGRAM_VERIFY_TOKEN.
FACEBOOK_VERIFY_TOKEN=""
# Page token from GET /me/accounts with a long-lived user token (does not expire).
FACEBOOK_PAGE_ACCESS_TOKEN=""

# WhatsApp Cloud API (phase 6), on your number via Coexistence. Same Meta app as Facebook.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Permanent system-user token: Business settings > System users > Generate token
# (whatsapp_business_messaging, whatsapp_business_management).
WHATSAPP_ACCESS_TOKEN=""
# Leave empty to reuse INSTAGRAM_VERIFY_TOKEN.
WHATSAPP_VERIFY_TOKEN=""
# Template rates in ₹ before 18% GST, for broadcast cost previews (check Meta's India rate card).
WA_RATE_MARKETING_INR="0.86"
WA_RATE_UTILITY_INR="0.115"
WA_RATE_AUTHENTICATION_INR="0.115"

# AI intent for Hinglish (phase 6). Off until a key is set. Cap is in US$ per month.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"
AI_MONTHLY_CAP_USD="5"

# Web push for the inbox (phase 4). Generate once:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# https: URL or mailto: address. Defaults to APP_URL when that is https.
VAPID_SUBJECT=""

# Razorpay (phase 5). Dashboard > Account & Settings > API keys. Use rzp_test_ keys until verified.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard > Webhooks: URL https://<app>/api/webhooks/razorpay, events payment_link.paid / expired / cancelled.
RAZORPAY_WEBHOOK_SECRET=""

# Catalogue sync (phase 5): a JSON feed of designs on the Red Thread site.
CATALOGUE_URL=""
CATALOGUE_TOKEN=""

# Admin login (HTTP basic auth) for the dashboard.
ADMIN_USER="admin"
ADMIN_PASSWORD=""

# Vercel Cron sends this as a Bearer token to /api/cron/refresh-token.
CRON_SECRET=""
