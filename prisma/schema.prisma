generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Channel {
  INSTAGRAM
  FACEBOOK
  WHATSAPP
}

/// The connected Instagram account, Facebook Page or WhatsApp number (phone number ID). At most one per channel.
model Account {
  id             String    @id @default(cuid())
  channel        Channel   @unique
  /// Instagram user ID (webhook entry.id) or Facebook Page ID.
  externalId     String
  /// Instagram handle, or the Facebook Page name.
  username       String?
  accessToken    String
  /// Instagram only. Page tokens made from a long-lived user token don't expire.
  tokenExpiresAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Contact {
  id         String        @id @default(cuid())
  channel    Channel
  /// ID seen on comments, or on DMs for people who messaged first.
  externalId String
  /// ID seen on DMs (IGSID / PSID) when it differs. Learnt from the private reply response.
  dmId       String?
  /// Instagram handle, or the Facebook / WhatsApp display name.
  username   String?
  name       String?
  /// Digits with country code (919876543210). WhatsApp contacts always have it; others once they share it.
  /// Contacts on different channels with the same phone are the same person.
  phone      String?
  /// Agreed to WhatsApp marketing messages (broadcasts). Cleared by STOP.
  marketingOptInAt DateTime?
  isFollower Boolean?
  optedOut   Boolean       @default(false)
  /// Answers to flow questions, by field name.
  fields         Json          @default("{}")
  /// Last DM from the person. Meta only allows replies within 24 h of it.
  lastInboundAt  DateTime?
  lastMessageAt  DateTime?
  lastReadAt     DateTime?
  /// Bot stays quiet until then: you're talking to them yourself.
  handoffUntil   DateTime?
  /// Set when they asked for a person; cleared when you reply or hand back.
  handoffAskedAt DateTime?
  lastNotifiedAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  comments       Comment[]
  sessions       LinkSession[]
  links          ShortLink[]
  tags           ContactTag[]
  flowRuns       FlowRun[]
  messages       Message[]
  orders         Order[]

  @@unique([channel, externalId])
  @@unique([channel, dmId])
  @@index([lastMessageAt])
  @@index([phone])
}

enum TriggerKind {
  /// Comments on posts and reels.
  COMMENT
  /// Replies to Instagram stories.
  STORY_REPLY
  /// A DM that matches keywords (or an AI intent). Every channel, including WhatsApp.
  DM_KEYWORD
}

enum TriggerScope {
  /// Only the chosen posts or reels.
  POSTS
  /// Every post (or every story), checked after post-specific triggers.
  ALL_POSTS
  /// Fallback when nothing else matched.
  DEFAULT
}

/// One automation: which comments or story replies it answers, and what it sends.
model Trigger {
  id               String        @id @default(cuid())
  name             String
  active           Boolean       @default(true)
  channel          Channel       @default(INSTAGRAM)
  kind             TriggerKind   @default(COMMENT)
  scope            TriggerScope  @default(POSTS)
  mediaIds         String[]
  /// DM keyword automations: AI intents that also start it when no keyword matched.
  intents          String[]
  /// Empty = any text. A trailing * matches prefixes (kitn* = kitna, kitne).
  keywords         String[]
  excludeWords     String[]
  /// Comments only. One is picked at random. {username} is replaced.
  publicReplies    String[]
  /// When set, the flow runs instead of the fixed DM → follow → link journey.
  flowId           String?
  flow             Flow?         @relation(fields: [flowId], references: [id], onDelete: SetNull)
  dmText           String        @default("")
  dmButtonText     String        @default("Send me the link")
  /// Instagram only: Facebook has no follow check.
  followGate       Boolean       @default(true)
  followPromptText String        @default("Follow us first, then tap the button below and the link is yours.")
  followButtonText String        @default("I've followed")
  linkUrl          String        @default("")
  linkMessage      String        @default("Here's your link:")
  oncePerPerson    Boolean       @default(true)
  priority         Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  comments         Comment[]
  sessions         LinkSession[]
  links            ShortLink[]
  flowRuns         FlowRun[]

  @@index([channel, kind, active])
}

enum EventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

model WebhookEvent {
  id          String      @id @default(cuid())
  source      String
  kind        String
  dedupeKey   String      @unique
  payload     Json
  status      EventStatus @default(RECEIVED)
  error       String?
  receivedAt  DateTime    @default(now())
  processedAt DateTime?

  @@index([status, receivedAt])
}

model Comment {
  id            String       @id @default(cuid())
  channel       Channel
  commentId     String
  /// Instagram media ID or Facebook post ID.
  mediaId       String
  text          String
  fromId        String
  fromUsername  String?
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id])
  triggerId     String?
  trigger       Trigger?     @relation(fields: [triggerId], references: [id], onDelete: SetNull)
  matched       Boolean      @default(false)
  skipReason    String?
  error         String?
  publicReplyId String?
  dmSentAt      DateTime?
  createdAt     DateTime     @default(now())
  session       LinkSession?
  flowRun       FlowRun?

  @@unique([channel, commentId])
  @@index([channel, mediaId, fromId, triggerId])
  @@index([createdAt])
}

enum SessionStatus {
  AWAITING_TAP
  AWAITING_FOLLOW
  LINK_SENT
}

/// One comment-or-story-reply to link journey for one person.
model LinkSession {
  id              String        @id @default(cuid())
  channel         Channel
  contactId       String
  contact         Contact       @relation(fields: [contactId], references: [id])
  triggerId       String
  trigger         Trigger       @relation(fields: [triggerId], references: [id], onDelete: Cascade)
  /// Set for comment sessions.
  commentId       String?       @unique
  comment         Comment?      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  /// Set for story-reply sessions.
  storyId         String?
  status          SessionStatus @default(AWAITING_TAP)
  followChecks    Int           @default(0)
  /// Result of the first follow check that got an answer.
  initialFollower Boolean?
  /// Not following at the first check, following when the link went out.
  followGained    Boolean       @default(false)
  linkSentAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  shortLink       ShortLink?

  @@index([contactId, status])
  @@index([linkSentAt])
}

/// A question shown when someone opens a new DM thread. Tapping it sends `reply`, plus a tracked link if set.
model IceBreaker {
  id        String      @id @default(cuid())
  channel   Channel
  question  String
  reply     String
  linkUrl   String?
  /// When set, a tap starts this flow instead of sending `reply`.
  flowId    String?
  flow      Flow?       @relation(fields: [flowId], references: [id], onDelete: SetNull)
  position  Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  links     ShortLink[]

  @@index([channel, position])
}

model ShortLink {
  id             String       @id @default(cuid())
  code           String       @unique
  url            String
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id])
  triggerId      String?
  trigger        Trigger?     @relation(fields: [triggerId], references: [id], onDelete: SetNull)
  sessionId      String?      @unique
  session        LinkSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  iceBreakerId   String?
  iceBreaker     IceBreaker?  @relation(fields: [iceBreakerId], references: [id], onDelete: SetNull)
  flowRunId      String?
  flowRun        FlowRun?     @relation(fields: [flowRunId], references: [id], onDelete: SetNull)
  clicks         Int          @default(0)
  firstClickedAt DateTime?
  lastClickedAt  DateTime?
  createdAt      DateTime     @default(now())
}

/// A conversation built in the flow builder. `graph` is { nodes, edges } in React Flow's shape.
model Flow {
  id          String       @id @default(cuid())
  name        String
  graph       Json
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  triggers    Trigger[]
  iceBreakers IceBreaker[]
  runs        FlowRun[]
}

enum FlowRunStatus {
  /// Waiting for a tap on one of the node's buttons.
  WAITING_BUTTON
  /// Waiting for a typed answer to a question.
  WAITING_ANSWER
  /// Waiting for a recheck on the follow gate.
  WAITING_FOLLOW
  /// Sent the private reply; can't message again until the person replies.
  WAITING_REPLY
  /// Sent a payment link; continues on the Razorpay paid / expired webhook.
  WAITING_PAYMENT
  DONE
  FAILED
}

/// One person going through one flow.
model FlowRun {
  id           String        @id @default(cuid())
  channel      Channel
  flowId       String
  flow         Flow          @relation(fields: [flowId], references: [id], onDelete: Cascade)
  contactId    String
  contact      Contact       @relation(fields: [contactId], references: [id])
  triggerId    String?
  trigger      Trigger?      @relation(fields: [triggerId], references: [id], onDelete: SetNull)
  commentId    String?       @unique
  comment      Comment?      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  storyId      String?
  status       FlowRunStatus @default(WAITING_REPLY)
  /// The node the run is waiting on.
  nodeId       String?
  /// Run-scoped values: chosen package, retry and follow-check counters.
  vars         Json          @default("{}")
  followGained Boolean       @default(false)
  error        String?
  startedAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  finishedAt   DateTime?
  links        ShortLink[]
  orders       Order[]

  @@index([contactId, status, updatedAt])
}

model Tag {
  id        String       @id @default(cuid())
  name      String       @unique
  createdAt DateTime     @default(now())
  contacts  ContactTag[]
}

model ContactTag {
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([contactId, tagId])
}

/// Red Thread packages for the package picker. Synced from the website in phase 5; edited by hand until then.
model Package {
  id        String   @id @default(cuid())
  name      String
  priceInr  Int
  url       String
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

enum MessageDirection {
  IN
  OUT
}

enum MessageSource {
  /// The person.
  CONTACT
  /// Automations and flows.
  BOT
  /// You, from the inbox here.
  ADMIN
  /// You, typing in the Instagram or Messenger app (seen as an echo).
  APP
}

/// Every DM in and out, for the inbox.
model Message {
  id        String           @id @default(cuid())
  channel   Channel
  contactId String
  contact   Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  direction MessageDirection
  source    MessageSource
  text      String
  /// Button titles sent with an outgoing message, or the tapped payload's title.
  buttons   String[]
  mid       String?
  createdAt DateTime         @default(now())

  @@unique([channel, mid])
  @@index([contactId, createdAt])
}

/// A browser or installed PWA that gets push notifications.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
}

/// A design from the Red Thread site. Synced; `showInCarousel` is ours.
model CatalogueItem {
  id             String    @id @default(cuid())
  /// The site's ID (or slug) for the design.
  externalId     String    @unique
  name           String
  occasion       String?
  imageUrl       String?
  previewUrl     String?
  priceInr       Int?
  /// As the site reports it. Missing from the last sync = false.
  active         Boolean   @default(true)
  showInCarousel Boolean   @default(true)
  position       Int       @default(0)
  raw            Json?
  syncedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  orders         Order[]

  @@index([active, showInCarousel, occasion])
}

enum OrderStage {
  /// Interested, no link yet.
  LEAD
  PAYMENT_SENT
  PAID
  /// Collecting names, dates, venue, photos.
  DETAILS
  IN_PROGRESS
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  EXPIRED
  CANCELLED
}

model Order {
  id                String         @id @default(cuid())
  /// Shown as RT-<1000 + number>.
  number            Int            @unique @default(autoincrement())
  channel           Channel
  contactId         String
  contact           Contact        @relation(fields: [contactId], references: [id])
  /// Design or package name, as sold.
  title             String
  amountInr         Int
  packageId         String?
  package           Package?       @relation(fields: [packageId], references: [id], onDelete: SetNull)
  designId          String?
  design            CatalogueItem? @relation(fields: [designId], references: [id], onDelete: SetNull)
  flowRunId         String?
  flowRun           FlowRun?       @relation(fields: [flowRunId], references: [id], onDelete: SetNull)
  stage             OrderStage     @default(PAYMENT_SENT)
  paymentStatus     PaymentStatus  @default(UNPAID)
  razorpayLinkId    String?        @unique
  razorpayLinkUrl   String?
  razorpayPaymentId String?
  paidAt            DateTime?
  /// Intake answers: couple_names, venue, maps_link, photos...
  details           Json           @default("{}")
  eventDate         DateTime?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([stage, updatedAt])
  @@index([contactId])
}

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

/// A WhatsApp message template (needs Meta approval). Mirrors the WABA's templates.
model WaTemplate {
  id         String           @id @default(cuid())
  name       String
  language   String
  category   TemplateCategory
  /// APPROVED, PENDING, REJECTED, PAUSED, DISABLED (as Meta reports it).
  status     String
  /// Meta's components array (HEADER, BODY, FOOTER, BUTTONS).
  components Json
  metaId     String?
  reason     String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  broadcasts Broadcast[]

  @@unique([name, language])
}

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  SENDING
  DONE
  CANCELLED
}

/// A template sent to opted-in WhatsApp contacts (optionally one tag).
model Broadcast {
  id               String              @id @default(cuid())
  name             String
  templateId       String
  template         WaTemplate          @relation(fields: [templateId], references: [id])
  /// Only contacts with this tag; null = every opted-in WhatsApp contact.
  tag              String?
  /// One source per {{n}} in the body: {"kind":"name"} | {"kind":"field","field":"city"} | {"kind":"text","value":"…"}.
  variables        Json                @default("[]")
  status           BroadcastStatus     @default(DRAFT)
  scheduledAt      DateTime?
  /// ₹, with 18% GST, at the rate when it was planned.
  estimatedCostInr Float?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  recipients       BroadcastRecipient[]

  @@index([status, scheduledAt])
}

enum RecipientStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model BroadcastRecipient {
  id          String          @id @default(cuid())
  broadcastId String
  broadcast   Broadcast       @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contactId   String
  status      RecipientStatus @default(PENDING)
  waMessageId String?         @unique
  error       String?
  sentAt      DateTime?
  updatedAt   DateTime        @updatedAt

  @@unique([broadcastId, contactId])
  @@index([broadcastId, status])
}

/// One AI call, for the monthly spend cap.
model AiUsage {
  id           String   @id @default(cuid())
  /// YYYY-MM, India time.
  month        String
  purpose      String
  model        String
  inputTokens  Int
  outputTokens Int
  costUsd      Float
  createdAt    DateTime @default(now())

  @@index([month])
}
